# Postgres 连接串。多租户数据持久化于此。
# 生产示例（阿里云 RDS PostgreSQL）：
#   postgresql://<user>:<password>@<rds-host>:5432/three_stage_engine?schema=public&sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/three_stage_engine?schema=public"

# 会话 cookie 的 HMAC 签名密钥（务必生产环境设置一个高强度随机值！）。
# ⚠️ 不设置会回落到 src/lib/auth.ts 里公开的开发默认值，任何人都能伪造任意 role/tenantId 的有效会话，
#    同时击穿网站登录与采集插件的登录门槛。生成示例：openssl rand -hex 32
# 注意：采集插件门槛端点 /api/auth/me 与中间件都用它验签，须对 Node 与 Edge 运行时都可见。
SESSION_SECRET="change-me-to-a-long-random-string"

# 安全限流默认不信任客户端提交的 IP 头。
# 仅当 Nginx 已覆盖 X-Real-IP，且上游端口仅监听 loopback/禁止公网直连后设 true。
# 发布前先单独应用 20261002143000_security_rate_bucket/migration.sql。
SANJIE_TRUST_PROXY_IP="false"

# 数据看板分享快照加密密钥（AES-GCM 派生使用）。生产建议单独设置，不与 SESSION_SECRET 混用。
# 生成示例：openssl rand -hex 32
SHARE_ENCRYPTION_KEY="change-me-to-another-long-random-string"

# 店铺 AI API Key 的独立 AES-GCM 派生密钥。生产环境强制要求，不能与上面两项复用。
# 生成示例：openssl rand -hex 32
AI_API_ENCRYPTION_KEY="change-me-to-a-third-long-random-string"

# 少壮 AI 模型网关：上游模型服务配置。
# 开通哪些供应商，就填写对应 API Key；未填写的供应商会在调用时返回“未配置”。
MODEL_GATEWAY_SHAOZHUANG_API_KEY=""
MODEL_GATEWAY_SHAOZHUANG_BASE_URL="https://sub.shaozhuangai.com/v1"

MODEL_GATEWAY_OPENAI_API_KEY=""
MODEL_GATEWAY_OPENAI_BASE_URL="https://api.openai.com/v1"

MODEL_GATEWAY_DEEPSEEK_API_KEY=""
MODEL_GATEWAY_DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

MODEL_GATEWAY_DASHSCOPE_API_KEY=""
MODEL_GATEWAY_DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

MODEL_GATEWAY_VOLC_API_KEY=""
MODEL_GATEWAY_VOLC_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"

MODEL_GATEWAY_ZHIPU_API_KEY=""
MODEL_GATEWAY_ZHIPU_BASE_URL="https://open.bigmodel.cn/api/paas/v4"

# 人工收款仍使用独立入口；扫码支付通过下列渠道配置启用。
# 不支持 AUTO_PAY；此变量保持 manual，不能用它绕过支付验签。
MODEL_GATEWAY_PAYMENT_PROVIDER="manual"
MODEL_GATEWAY_MANUAL_PAY_URL=""

# 扫码支付：仅服务端配置，禁止使用 NEXT_PUBLIC_ 前缀或提交真实密钥。
# 完成商户签约、应用上线及 Native/当面付权限后再配置；空配置不显示付款码。
SCAN_PAYMENT_NOTIFY_BASE_URL="https://shaozhuangai.com"
# 支付宝 RSA2 密钥模式。PRIVATE_KEY 为应用私钥，PUBLIC_KEY 为支付宝公钥。
# 回调：https://shaozhuangai.com/api/payments/alipay/notify
ALIPAY_APP_ID=""
ALIPAY_SELLER_ID=""
# 电脑网站支付已开通时选择 page_pay；precreate 需要另有当面付权限。
ALIPAY_PAYMENT_PRODUCT="precreate"
ALIPAY_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""
# 微信 Native API v3，公钥模式。PUBLIC_KEY_ID 为微信支付公钥 ID。
# 回调：https://shaozhuangai.com/api/payments/wechat/notify
WECHAT_PAY_APP_ID=""
WECHAT_PAY_MCH_ID=""
WECHAT_PAY_PRIVATE_KEY=""
WECHAT_PAY_SERIAL_NO=""
WECHAT_PAY_API_V3_KEY=""
WECHAT_PAY_PUBLIC_KEY=""
WECHAT_PAY_PUBLIC_KEY_ID=""

# 按已确认分镜逐镜生成 AI 配音。独立配置；禁止借用视频 Key，不发送上传原音频。
# 必须核对明确的服务商/模型/音色及对应计费单位后显式启用；缺项时不提交。
NARRATION_SPEECH_ENABLED="false"
# 旧配置缺省 openai；使用 Fish Audio 时明确设为 fish，端点固定 https://api.fish.audio/v1/tts。
NARRATION_SPEECH_PROVIDER="openai"
NARRATION_SPEECH_API_KEY=""
# BASE_URL 与 VOICE 仅供 OpenAI 兼容适配；Fish 不会把 VOICE 作为 reference_id。
NARRATION_SPEECH_BASE_URL="https://api.openai.com/v1"
# Fish 必须显式选择已核对模型；缺省或拼错会被本地拒绝，禁止回退付费默认模型。
NARRATION_SPEECH_MODEL=""
NARRATION_SPEECH_VOICE=""
NARRATION_SPEECH_CENTS_PER_1K_CHAR=""
# Fish 使用已确认的音色模型 ID，不自动上传音频、创建或克隆新音色。
NARRATION_SPEECH_REFERENCE_ID=""
# Fish 费率单位：人民币分/百万 UTF-8 字节，不能把中文字符数当字节数，也不自动推算汇率。
# 仅明确选择 s2.1-pro-free 时允许显式费率 0；其它模型必须配置正费率。
NARRATION_SPEECH_CENTS_PER_MILLION_UTF8_BYTES=""
# 必填固定共享目录的绝对路径，独立于每次发布目录；所有进程共用、重启后保留。
# 回执与音频按账号隔离，缺此目录配置时不会提交供应商。
NARRATION_SPEECH_STORAGE_DIR=""
