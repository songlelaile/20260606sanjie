# Postgres 连接串。多租户数据持久化于此。
# 生产示例（阿里云 RDS PostgreSQL）：
#   postgresql://<user>:<password>@<rds-host>:5432/three_stage_engine?schema=public&sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/three_stage_engine?schema=public"

# 会话 cookie 的 HMAC 签名密钥（务必生产环境设置一个高强度随机值！）。
# ⚠️ 不设置会回落到 src/lib/auth.ts 里公开的开发默认值，任何人都能伪造任意 role/tenantId 的有效会话，
#    同时击穿网站登录与采集插件的登录门槛。生成示例：openssl rand -hex 32
# 注意：采集插件门槛端点 /api/auth/me 与中间件都用它验签，须对 Node 与 Edge 运行时都可见。
SESSION_SECRET="change-me-to-a-long-random-string"
