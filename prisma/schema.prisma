// 多租户持久化（Postgres）。
// 设计：跨租户需索引/查询的实体用关系表（Tenant/User/InviteCode）；
// 每个租户的工作区状态（源数据导入、预填、利润配置、看板计算、版本、历史）
// 以 JSON blob 存于 Workspace.data（一行一租户），复用现有领域逻辑、按 tenantId 隔离。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  createdAt DateTime     @default(now())
  users     User[]
  invites   InviteCode[]
  shops     Shop[]
  workspace Workspace?
  calcRun   CalcRun?
  dmpReports DmpBusinessReport[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  username     String   @unique
  password     String
  name         String
  authRole     String   @default("tenant") // 登录权限：tenant | admin
  role         String   @default("operator") // 管理视图角色：owner | admin | operator | viewer
  email        String   @default("")
  shopName     String   @default("")
  status       String   @default("active")
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  gatewayWallet GatewayWallet?
  gatewayApiKeys GatewayApiKey[]
  gatewayOrders  GatewayOrder[]
  gatewayUsages  GatewayUsage[]
  toolEntitlements ToolEntitlement[]
  dmpReports       DmpBusinessReport[]

  @@index([tenantId])
}

// 按账号单独开通的付费工具权限。toolCode 使用稳定产品码，插件升级不要求重复授权；
// revoked 记录保留授权/撤销痕迹，不通过删除行来表达未授权。
model ToolEntitlement {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolCode  String
  status    String   @default("active") // active | revoked
  grantedBy String   @default("")
  grantedAt DateTime @default(now())
  expiresAt DateTime?
  note      String   @default("")
  updatedAt DateTime @updatedAt

  @@unique([userId, toolCode])
  @@index([toolCode, status])
}

model InviteCode {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code            String   @unique
  registrationUrl String
  usedCount       Int      @default(0)
  maxUses         Int      @default(1)
  note            String   @default("")
  createdBy       String   @default("")
  createdAt       DateTime @default(now())

  @@index([tenantId])
}

model Shop {
  id          String          @id
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  platform    String          @default("淘宝")
  createdBy   String          @default("")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  workspace   ShopWorkspace?
  calcRun     ShopCalcRun?
  shares      DashboardShare[]

  @@index([tenantId])
}

model Workspace {
  tenantId  String   @id
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  data      Json
  updatedAt DateTime @updatedAt
}

model ShopWorkspace {
  id        String   @id @default(cuid())
  tenantId  String
  shopId    String   @unique
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  data      Json
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// 三阶计算结果（每租户一份）。原先内嵌 Workspace.data blob（占 ~96%，audiencePlans 最大），
// 外置成独立表 + 分段列：每个看板用 Prisma select 只取自己的切片，且日常 mutation 不再重写它。
model CalcRun {
  tenantId            String   @id
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runId               String   @default("")
  cycleId             String   @default("")
  createdAt           String   @default("")
  schemaVersion       Int      @default(1)
  investmentResults   Json     @default("[]")
  breakthroughResults Json     @default("[]")
  audiencePlans       Json     @default("[]")
  managementDashboard Json     @default("{}")
  updatedAt           DateTime @updatedAt
}

model ShopCalcRun {
  id                  String   @id @default(cuid())
  tenantId            String
  shopId              String   @unique
  shop                Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  runId               String   @default("")
  cycleId             String   @default("")
  createdAt           String   @default("")
  schemaVersion       Int      @default(1)
  investmentResults   Json     @default("[]")
  breakthroughResults Json     @default("[]")
  audiencePlans       Json     @default("[]")
  managementDashboard Json     @default("{}")
  updatedAt           DateTime @updatedAt

  @@index([tenantId])
}

model DashboardShare {
  id               String   @id @default(cuid())
  tenantId         String
  shopId           String
  shop             Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  tokenHash        String   @unique
  title            String
  encryptedPayload String   @db.Text
  createdBy        String   @default("")
  createdAt        DateTime @default(now())

  @@index([tenantId, shopId])
}

model DmpBusinessReport {
  id               String   @id @default(cuid())
  tenantId         String
  userId           String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectItemId    String
  competitorItemId String
  period           String   @default("")
  quality          String   @default("complete")
  sourceVersion    String   @default("")
  report           Json
  createdAt        DateTime @default(now())

  @@index([tenantId, userId, createdAt])
}

// 分日商品源指标（v2 时序底座）。date 存归一化 ISO 字符串(YYYY-MM-DD)，
// ISO 字典序=时间序，便于按区间查询；(tenantId, productId, date) 唯一，重传同日覆盖。
model DailyProductMetric {
  id        String @id @default(cuid())
  tenantId  String
  shopId    String @default("")
  productId String
  date      String

  productName                       String @default("")
  visitors                          Int?
  views                             Int?
  averageStaySeconds                Float?
  bounceRate                        Float?
  paymentBuyers                     Int?
  paymentAmount                     Float?
  productPaymentConversionRate      Float?
  refundAmount                      Float?
  searchGuidedPaymentConversionRate Float?
  searchGuidedVisitors              Int?

  updatedAt DateTime @updatedAt

  @@unique([tenantId, shopId, productId, date])
  @@index([tenantId, shopId, date])
}

// 分日推广宝贝指标（v2）。(tenantId, subjectId, date) 唯一，重传同日覆盖。
model DailyPromotionMetric {
  id          String @id @default(cuid())
  tenantId    String
  shopId      String @default("")
  subjectId   String
  date        String
  subjectName String @default("")
  impressions Int?
  clicks      Int?
  cost        Float?
  roi         Float?
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, shopId, subjectId, date])
  @@index([tenantId, shopId, date])
}

// 分日人群指标（v2）。粒度 (date, planId, audienceName, subjectId)。
model DailyAudienceMetric {
  id                          String @id @default(cuid())
  tenantId                    String
  shopId                      String @default("")
  date                        String
  sceneId                     String @default("")
  sceneName                   String @default("")
  planId                      String
  planName                    String @default("")
  audienceName                String
  subjectId                   String
  subjectName                 String @default("")
  clicks                      Int?
  roi                         Float?
  guidedPotentialCustomerRatio Float?
  newCustomerRatio            Float?
  updatedAt                   DateTime @updatedAt

  @@unique([tenantId, shopId, date, planId, audienceName, subjectId])
  @@index([tenantId, shopId, date])
  // 按主体(=商品)筛选的窗口查询（受影响商品的人群对比）：唯一键以 date 起头，subjectId 落在末位无法裁剪；
  // 此索引让 subjectId IN 直接定位，避免读全窗口再丢弃 95% 行。
  @@index([tenantId, shopId, subjectId, date])
}

// 运营手动标记的"优化动作"（v2 前后对比锚点）。date=动作发生日；productIds=受影响商品(空=整店)。
model Intervention {
  id         String   @id @default(cuid())
  tenantId   String
  shopId     String   @default("")
  date       String // 归一化 ISO YYYY-MM-DD
  title      String
  note       String   @default("")
  category   String   @default("")
  productIds Json     @default("[]")
  createdBy  String   @default("")
  createdAt  DateTime @default(now())

  @@index([tenantId, shopId, date])
}

// 少壮 AI 模型网关：用户钱包。以人民币分为单位存储，避免浮点误差。
model GatewayWallet {
  userId            String   @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balanceCents      Int      @default(0)
  monthlyQuotaCents Int      @default(0)
  planCode          String   @default("free")
  planName          String   @default("体验版")
  periodStart       DateTime @default(now())
  periodEnd         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// 用户在网关里创建的 API Key。只保存哈希和前缀，不保存明文。
model GatewayApiKey {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String         @unique
  keyPrefix  String
  status     String         @default("active")
  createdAt  DateTime       @default(now())
  lastUsedAt DateTime?
  usages     GatewayUsage[]

  @@index([userId, status])
}

// 套餐/充值订单。真实支付接入后由支付回调把 status 改为 paid 并充值钱包。
model GatewayOrder {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planCode        String
  planName        String
  amountCents     Int
  creditCents     Int
  status          String    @default("pending")
  paymentProvider String    @default("manual")
  paymentUrl      String    @default("")
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([status])
}

// 网关调用流水。先按模型基础价格估算并扣费，后续可替换成上游返回 token 结算。
model GatewayUsage {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeyId         String?
  apiKey           GatewayApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  requestId        String        @default("")
  endpoint         String
  provider         String
  model            String
  promptTokens     Int           @default(0)
  completionTokens Int           @default(0)
  totalTokens      Int           @default(0)
  imageCount       Int           @default(0)
  costCents        Int           @default(0)
  status           String        @default("ok")
  error            String        @default("")
  createdAt        DateTime      @default(now())
  metadata         Json          @default("{}")

  @@index([userId, createdAt])
  @@index([apiKeyId, createdAt])
}
