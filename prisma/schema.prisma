// 多租户持久化（Postgres）。
// 设计：跨租户需索引/查询的实体用关系表（Tenant/User/InviteCode）；
// 每个租户的工作区状态（源数据导入、预填、利润配置、看板计算、版本、历史）
// 以 JSON blob 存于 Workspace.data（一行一租户），复用现有领域逻辑、按 tenantId 隔离。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  createdAt DateTime     @default(now())
  users     User[]
  invites   InviteCode[]
  workspace Workspace?
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  username     String   @unique
  password     String
  name         String
  authRole     String   @default("tenant") // 登录权限：tenant | admin
  role         String   @default("operator") // 管理视图角色：owner | admin | operator | viewer
  email        String   @default("")
  shopName     String   @default("")
  status       String   @default("active")
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  @@index([tenantId])
}

model InviteCode {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code            String   @unique
  registrationUrl String
  usedCount       Int      @default(0)
  maxUses         Int      @default(1)
  note            String   @default("")
  createdBy       String   @default("")
  createdAt       DateTime @default(now())

  @@index([tenantId])
}

model Workspace {
  tenantId  String   @id
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  data      Json
  updatedAt DateTime @updatedAt
}
