// 多租户持久化（Postgres）。
// 设计：跨租户需索引/查询的实体用关系表（Tenant/User/InviteCode）；
// 每个租户的工作区状态（源数据导入、预填、利润配置、看板计算、版本、历史）
// 以 JSON blob 存于 Workspace.data（一行一租户），复用现有领域逻辑、按 tenantId 隔离。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id              String                  @id @default(cuid())
  name            String
  slug            String                  @unique
  createdAt       DateTime                @default(now())
  users           User[]
  invites         InviteCode[]
  shops           Shop[]
  workspace       Workspace?
  calcRun         CalcRun?
  dmpReports      DmpBusinessReport[]
  nativeVideoJobs GatewayNativeVideoJob[]
}

model User {
  aiAccessGrants    AIAccessGrant[]
  id                String                    @id @default(cuid())
  tenantId          String
  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  username          String                    @unique
  password          String
  name              String
  authRole          String                    @default("tenant") // 登录权限：tenant | admin
  role              String                    @default("operator") // 管理视图角色：owner | admin | operator | viewer
  email             String                    @default("")
  shopName          String                    @default("")
  status            String                    @default("active")
  createdAt         DateTime                  @default(now())
  lastActiveAt      DateTime                  @default(now())
  gatewayWallet     GatewayWallet?
  gatewayApiKeys    GatewayApiKey[]
  gatewayOrders     GatewayOrder[]
  gatewayUsages     GatewayUsage[]
  toolEntitlements  ToolEntitlement[]
  nativeVideoJobs   GatewayNativeVideoJob[]
  dmpReports        DmpBusinessReport[]
  supplyCredentials GatewaySupplyCredential[]

  @@index([tenantId])
}

// 按账号单独开通的付费工具权限。toolCode 使用稳定产品码，插件升级不要求重复授权；
// revoked 记录保留授权/撤销痕迹，不通过删除行来表达未授权。
model ToolEntitlement {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolCode  String
  status    String    @default("active") // active | revoked
  grantedBy String    @default("")
  grantedAt DateTime  @default(now())
  expiresAt DateTime?
  note      String    @default("")
  updatedAt DateTime  @updatedAt

  @@unique([userId, toolCode])
  @@index([toolCode, status])
}

model InviteCode {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code            String   @unique
  registrationUrl String
  usedCount       Int      @default(0)
  maxUses         Int      @default(1)
  note            String   @default("")
  createdBy       String   @default("")
  createdAt       DateTime @default(now())

  @@index([tenantId])
}

model Shop {
  id         String              @id
  tenantId   String
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  platform   String              @default("淘宝")
  createdBy  String              @default("")
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  workspace  ShopWorkspace?
  calcRun    ShopCalcRun?
  shares     DashboardShare[]
  dmpReports DmpBusinessReport[]

  @@index([tenantId])
}

model Workspace {
  tenantId  String   @id
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  data      Json
  updatedAt DateTime @updatedAt
}

model ShopWorkspace {
  id        String   @id @default(cuid())
  tenantId  String
  shopId    String   @unique
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  data      Json
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// 三阶计算结果（每租户一份）。原先内嵌 Workspace.data blob（占 ~96%，audiencePlans 最大），
// 外置成独立表 + 分段列：每个看板用 Prisma select 只取自己的切片，且日常 mutation 不再重写它。
model CalcRun {
  tenantId            String   @id
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runId               String   @default("")
  cycleId             String   @default("")
  createdAt           String   @default("")
  schemaVersion       Int      @default(1)
  investmentResults   Json     @default("[]")
  breakthroughResults Json     @default("[]")
  audiencePlans       Json     @default("[]")
  managementDashboard Json     @default("{}")
  updatedAt           DateTime @updatedAt
}

model ShopCalcRun {
  id                  String   @id @default(cuid())
  tenantId            String
  shopId              String   @unique
  shop                Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  runId               String   @default("")
  cycleId             String   @default("")
  createdAt           String   @default("")
  schemaVersion       Int      @default(1)
  investmentResults   Json     @default("[]")
  breakthroughResults Json     @default("[]")
  audiencePlans       Json     @default("[]")
  managementDashboard Json     @default("{}")
  updatedAt           DateTime @updatedAt

  @@index([tenantId])
}

model DashboardShare {
  id               String   @id @default(cuid())
  tenantId         String
  shopId           String
  shop             Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  tokenHash        String   @unique
  title            String
  encryptedPayload String   @db.Text
  createdBy        String   @default("")
  createdAt        DateTime @default(now())

  @@index([tenantId, shopId])
}

model DmpBusinessReport {
  id               String           @id @default(cuid())
  tenantId         String
  userId           String
  shopId           String?
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop             Shop?            @relation(fields: [shopId], references: [id], onDelete: SetNull)
  subjectItemId    String
  competitorItemId String
  period           String           @default("")
  quality          String           @default("complete")
  sourceVersion    String           @default("")
  fingerprint      String?
  report           Json
  createdAt        DateTime         @default(now())
  shares           DmpReportShare[]

  @@unique([tenantId, userId, fingerprint])
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, userId, shopId, createdAt])
}

// 管理员在插件中导出达摩盘报告表格版 XLSX 的最小审计记录。
// 只保存授权主体、报告引用和导出元数据，不保存报告 JSON、业务单元格、文件名或下载内容。
// 故意不设级联外键：即使账号或报告后来删除，既有审计记录仍需保留。
model DmpReportExportAudit {
  id            String   @id @default(cuid())
  adminId       String
  reportId      String
  reportType    String
  format        String
  clientVersion String   @default("")
  exportedAt    DateTime @default(now())

  @@index([adminId, exportedAt])
  @@index([reportId, exportedAt])
  @@index([exportedAt])
}

// 达摩盘业务报告的官网公开只读链接。任何持有高熵令牌者均可读取，创建仍校验报告归属与付费权限。
// 数据库只保存令牌哈希，原始令牌仅在创建时返回；管理员可随时撤销。
model DmpReportShare {
  id            String                  @id @default(cuid())
  reportId      String
  report        DmpBusinessReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  tokenHash     String                  @unique
  viewCount     Int                     @default(0)
  clickCount    Int                     @default(0)
  lastViewedAt  DateTime?
  lastClickedAt DateTime?
  revokedAt     DateTime?
  createdAt     DateTime                @default(now())
  heatBuckets   DmpReportHeatBucket[]
  sessions      DmpReportShareSession[]
  events        DmpReportShareEvent[]

  @@index([reportId, createdAt])
  @@index([revokedAt, createdAt])
}

// 只保存匿名聚合坐标与元素键，不保存访客身份、IP、UA、Cookie 或单元格业务值。
model DmpReportHeatBucket {
  id         String         @id @default(cuid())
  shareId    String
  share      DmpReportShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  sectionKey String
  elementKey String
  xBucket    Int
  yBucket    Int
  count      Int            @default(0)
  updatedAt  DateTime       @updatedAt

  @@unique([shareId, sectionKey, elementKey, xBucket, yBucket])
  @@index([shareId, sectionKey, count])
}

// 公开分享页的匿名会话聚合。浏览器随机标识进入数据库前按分享链接加盐哈希；
// 不保存 IP、UA、Cookie、完整来源 URL 或报告业务内容。
model DmpReportShareSession {
  id             String         @id @default(cuid())
  shareId        String
  share          DmpReportShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  visitorHash    String
  sessionHash    String
  source         String         @default("")
  medium         String         @default("")
  campaign       String         @default("")
  referrerHost   String         @default("")
  pageViews      Int            @default(0)
  clickCount     Int            @default(0)
  activeSeconds  Int            @default(0)
  maxScrollDepth Int            @default(0)
  firstSeenAt    DateTime       @default(now())
  lastSeenAt     DateTime       @default(now())

  @@unique([shareId, sessionHash])
  @@index([shareId, firstSeenAt])
  @@index([shareId, visitorHash])
  @@index([firstSeenAt])
}

// 只保存客户端事件编号/访客/会话的分享级哈希和低维聚合数值；不保存事件原文或业务内容。
model DmpReportShareEvent {
  id             String         @id @default(cuid())
  shareId        String
  share          DmpReportShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  eventHash      String
  eventType      String
  visitorHash    String
  sessionHash    String
  source         String         @default("")
  medium         String         @default("")
  campaign       String         @default("")
  referrerHost   String         @default("")
  count          Int            @default(0)
  activeSeconds  Int            @default(0)
  maxScrollDepth Int            @default(0)
  createdAt      DateTime       @default(now())

  @@unique([shareId, eventHash])
  @@index([createdAt, eventType])
  @@index([shareId, sessionHash, createdAt])
}

// 分日商品源指标（v2 时序底座）。date 存归一化 ISO 字符串(YYYY-MM-DD)，
// ISO 字典序=时间序，便于按区间查询；(tenantId, productId, date) 唯一，重传同日覆盖。
model DailyProductMetric {
  id        String @id @default(cuid())
  tenantId  String
  shopId    String @default("")
  productId String
  date      String

  productName                       String @default("")
  visitors                          Int?
  views                             Int?
  averageStaySeconds                Float?
  bounceRate                        Float?
  paymentBuyers                     Int?
  paymentAmount                     Float?
  productPaymentConversionRate      Float?
  refundAmount                      Float?
  searchGuidedPaymentConversionRate Float?
  searchGuidedVisitors              Int?

  updatedAt DateTime @updatedAt

  @@unique([tenantId, shopId, productId, date])
  @@index([tenantId, shopId, date])
}

// 分日推广宝贝指标（v2）。(tenantId, subjectId, date) 唯一，重传同日覆盖。
model DailyPromotionMetric {
  id          String   @id @default(cuid())
  tenantId    String
  shopId      String   @default("")
  subjectId   String
  date        String
  subjectName String   @default("")
  impressions Int?
  clicks      Int?
  cost        Float?
  roi         Float?
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, shopId, subjectId, date])
  @@index([tenantId, shopId, date])
}

// 分日人群指标（v2）。粒度 (date, planId, audienceName, subjectId)。
model DailyAudienceMetric {
  id                           String   @id @default(cuid())
  tenantId                     String
  shopId                       String   @default("")
  date                         String
  sceneId                      String   @default("")
  sceneName                    String   @default("")
  planId                       String
  planName                     String   @default("")
  audienceName                 String
  subjectId                    String
  subjectName                  String   @default("")
  clicks                       Int?
  roi                          Float?
  guidedPotentialCustomerRatio Float?
  newCustomerRatio             Float?
  updatedAt                    DateTime @updatedAt

  @@unique([tenantId, shopId, date, planId, audienceName, subjectId])
  @@index([tenantId, shopId, date])
  // 按主体(=商品)筛选的窗口查询（受影响商品的人群对比）：唯一键以 date 起头，subjectId 落在末位无法裁剪；
  // 此索引让 subjectId IN 直接定位，避免读全窗口再丢弃 95% 行。
  @@index([tenantId, shopId, subjectId, date])
}

// 运营手动标记的"优化动作"（v2 前后对比锚点）。date=动作发生日；productIds=受影响商品(空=整店)。
model Intervention {
  id         String   @id @default(cuid())
  tenantId   String
  shopId     String   @default("")
  date       String // 归一化 ISO YYYY-MM-DD
  title      String
  note       String   @default("")
  category   String   @default("")
  productIds Json     @default("[]")
  createdBy  String   @default("")
  createdAt  DateTime @default(now())

  @@index([tenantId, shopId, date])
}

// 少壮 AI 模型网关：用户钱包。以人民币分为单位存储，避免浮点误差。
model GatewayWallet {
  userId            String   @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balanceCents      Int      @default(0)
  monthlyQuotaCents Int      @default(0)
  planCode          String   @default("free")
  planName          String   @default("体验版")
  periodStart       DateTime @default(now())
  periodEnd         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Unified accounting system's allocatable balance. No capacity is seeded or inferred.
// Only that system may activate id="total" after all purchases/reservations share this pool.
model GatewayCreditPool {
  id                       String                       @id @default("total")
  status                   String                       @default("pending") // pending | ready | blocked
  balanceCents             Int                          @default(0)
  accountingVersion        Int                          @default(0)
  capacityCents            BigInt                       @default(0)
  allocatedCents           BigInt                       @default(0)
  consumedCents            BigInt                       @default(0)
  deficitCents             BigInt                       @default(0)
  sourceSnapshotId         String?
  sourceScope              String                       @default("independent_usd")
  accountingEpochId        String?
  accountingEpochStartedAt DateTime?
  frozenValuationProduct   BigInt?
  sourceSnapshot           GatewayCreditSourceSnapshot? @relation(fields: [sourceSnapshotId], references: [id], onDelete: Restrict)
  entries                  GatewayCreditPoolLedger[]
  allocationWindows        GatewayCreditAllocationWindow[]
  revision                 Int                          @default(0)
  createdAt                DateTime                     @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)"))
  updatedAt                DateTime                     @updatedAt
}

// Append-only source proof. Only a reviewed server connector can produce verified records.
// Missing conversion/ownership/freshness proof remains pending with NULL capacity.
model GatewayCreditSourceSnapshot {
  id                   String                      @id @default(cuid())
  status               String                      @default("pending")
  snapshotHash         String                      @unique
  identityHash         String
  conversionPolicyHash String?
  nativeUnit           String?
  providerBaseUrl      String?
  sourceScope          String                      @default("independent_usd")
  accountingEpochId    String?
  capacityCents        Int?
  proof                Json
  observedAt           DateTime
  expiresAt            DateTime
  createdAt            DateTime                    @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  pools                GatewayCreditPool[]
  proposals            GatewayCreditPoolProposal[]
  entries              GatewayCreditPoolLedger[]
  observations         GatewayCreditSourceUsage[]
  allocationWindows    GatewayCreditAllocationWindow[]
}

// Each explicit successful verification starts one immutable 50% allocation window.
model GatewayCreditAllocationWindow {
  id               String @id
  poolId           String
  pool             GatewayCreditPool @relation(fields: [poolId], references: [id], onDelete: Restrict)
  sourceSnapshotId String @unique
  observationHash  String @unique
  sourceSnapshot   GatewayCreditSourceSnapshot @relation(fields: [sourceSnapshotId], references: [id], onDelete: Restrict)
  identityHash     String
  policyHash       String
  epochId          String
  poolRevision     Int
  baselineCents    Int
  limitCents       Int
  createdAt        DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  allocations      GatewayCreditAllocation[]
  verifications    GatewayCreditVerification[]
  @@unique([poolId, poolRevision])
}

model GatewayCreditVerification {
  requestKey String @id
  adminId    String
  windowId   String
  window     GatewayCreditAllocationWindow @relation(fields: [windowId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
}

// Positive gift/recharge allocations only. Refunds never replenish this budget.
model GatewayCreditAllocation {
  eventId     String @id
  ledger      GatewayCreditPoolLedger @relation(fields: [eventId], references: [eventId], onDelete: Restrict)
  windowId    String
  window      GatewayCreditAllocationWindow @relation(fields: [windowId], references: [id], onDelete: Restrict)
  kind        String
  amountCents Int
  createdAt   DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  @@index([windowId])
}

// Explicit administrator authorization. No FK deletion may erase its audit content.
model GatewayCreditGiftPlan {
  id           String @id
  requestKey   String @unique
  adminId      String
  userId       String
  amountCents  Int
  reason       String
  status       String @default("pending")
  lastCode     String?
  expiresAt    DateTime
  executedAt   DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt    DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  @@index([status, createdAt])
}

// Immutable approval facts; adoption is represented by an append-only journal, not a mutable flag.
model GatewayCreditPoolProposal {
  id                   String                      @id @default(cuid())
  snapshotId           String
  snapshot             GatewayCreditSourceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  snapshotHash         String
  identityHash         String
  conversionPolicyHash String
  adminId              String
  version              Int                         @default(1)
  kind                 String                      @default("adoption")
  consumedCents        BigInt                      @default(0)
  capacityCents        Int
  walletTotalCents     BigInt
  heldSubsetCents      BigInt
  walletStateHash      String
  expiresAt            DateTime
  createdAt            DateTime                    @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  entries              GatewayCreditPoolLedger[]
}

// Append-only pool movements. No FK to User: account deletion cannot erase audit evidence.
model GatewayCreditPoolLedger {
  id                     String                       @id @default(cuid())
  eventId                String                       @unique
  kind                   String
  poolId                 String
  pool                   GatewayCreditPool            @relation(fields: [poolId], references: [id], onDelete: Restrict)
  actorId                String?
  userId                 String?
  proposalId             String?
  proposal               GatewayCreditPoolProposal?   @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  sourceSnapshotId       String?
  sourceSnapshot         GatewayCreditSourceSnapshot? @relation(fields: [sourceSnapshotId], references: [id], onDelete: Restrict)
  deltaAllocatedCents    BigInt
  deltaConsumedCents     BigInt
  capacityCents          BigInt
  capacityBeforeCents    BigInt
  allocatedBeforeCents   BigInt
  allocatedAfterCents    BigInt
  consumedBeforeCents    BigInt
  consumedAfterCents     BigInt
  allocatableBeforeCents Int
  allocatableAfterCents  Int
  deficitAfterCents      BigInt
  deficitBeforeCents     BigInt                       @default(0)
  createdAt              DateTime                     @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  allocation             GatewayCreditAllocation?

  @@index([userId, createdAt])
}

// Actual upstream USD observation only; never a second wallet/pool debit.
model GatewayCreditSourceUsage {
  billingEventId        String                      @id
  billingLedger         GatewayBillingLedger        @relation(fields: [billingEventId], references: [billingEventId], onDelete: Restrict)
  sourceSnapshotId      String
  sourceSnapshot        GatewayCreditSourceSnapshot @relation(fields: [sourceSnapshotId], references: [id], onDelete: Restrict)
  identityHash          String
  groupId               String?
  cycleId               String?
  sourceScope           String                      @default("independent_usd")
  accountingEpochId     String?
  credentialFingerprint String?
  routingBindingHash    String?
  userId                String
  actualUsdUnits        BigInt?
  billingProvenance     String                      @default("upstream_actual_usd")
  localPricingHash      String?
  outcomeHash           String?
  // Response price is not evidence that asynchronous owner debit has committed.
  ownerDebitPosting     String                      @default("legacy_independent")
  eligibleUsdUnits      BigInt                      @default(0)
  createdAt             DateTime                    @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))

  @@index([identityHash, groupId, cycleId])
}

// Verified payment evidence survives insufficient capacity and account removal.
// Crediting is proven by recharge:<orderId> in the wallet and pool journals.
model GatewayCreditFundingEvidence {
  orderId             String   @id
  userId              String
  receipt             String   @unique
  provider            String
  receivedAmountCents Int
  creditCents         Int
  actorId             String?
  actorUsername       String?
  actorName           String?
  note                String
  createdAt           DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))

  @@index([userId])
}

// Immutable identity and balance snapshots; account removal must not delete gift history.
model GatewayCreditGift {
  id                String               @id @default(cuid())
  requestKey        String               @unique
  billingEventId    String               @unique
  billingLedger     GatewayBillingLedger @relation(fields: [billingEventId], references: [billingEventId], onDelete: Restrict)
  adminId           String
  adminUsername     String
  adminName         String
  adminTenantId     String
  adminTenantName   String
  userId            String
  username          String
  userName          String
  tenantId          String
  tenantName        String
  amountCents       Int
  poolBeforeCents   Int
  poolAfterCents    Int
  walletBeforeCents Int
  walletAfterCents  Int
  reason            String
  createdAt         DateTime             @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)"))

  @@index([userId, createdAt])
  @@index([adminId, createdAt])
  @@index([createdAt])
}

// 用户在网关里创建的 API Key。只保存哈希和前缀，不保存明文。
model GatewayApiKey {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String         @unique
  keyPrefix  String
  status     String         @default("active")
  createdAt  DateTime       @default(now())
  lastUsedAt DateTime?
  usages     GatewayUsage[]

  @@index([userId, status])
}

// 套餐/充值订单。真实支付接入后由支付回调把 status 改为 paid 并充值钱包。
model GatewayOrder {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planCode              String
  planName              String
  amountCents           Int
  creditCents           Int
  status                String    @default("pending")
  paymentProvider       String    @default("manual")
  paymentUrl            String    @default("")
  paymentReceipt        String?   @unique
  confirmedBy           String?
  confirmationNote      String?
  receivedAmountCents   Int?
  creditAllocationState String    @default("legacy") // legacy | credited | awaiting_capacity
  paidAt                DateTime?
  createdAt             DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([status])
}

// 网关调用流水。先按模型基础价格估算并扣费，后续可替换成上游返回 token 结算。
model GatewayUsage {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeyId         String?
  apiKey           GatewayApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  billingEventId   String?        @unique
  requestId        String         @default("")
  endpoint         String
  provider         String
  model            String
  promptTokens     Int            @default(0)
  completionTokens Int            @default(0)
  totalTokens      Int            @default(0)
  imageCount       Int            @default(0)
  costCents        Int            @default(0)
  status           String         @default("ok")
  error            String         @default("")
  createdAt        DateTime       @default(now())
  metadata         Json           @default("{}")

  @@index([userId, createdAt])
  @@index([apiKeyId, createdAt])
}

model SecurityRateBucket {
  bucketKey   String   @db.Char(64)
  windowStart DateTime @db.Timestamptz(6)
  expiresAt   DateTime @db.Timestamptz(6)
  hits        Int      @default(1)

  @@id([bucketKey, windowStart], map: "SecurityRateBucket_pkey")
  @@index([expiresAt], map: "SecurityRateBucket_expiresAt_idx")
}

// Explicit, short-lived administrator approval for the separate AI channel.
model AIAccessGrant {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  username     String
  tenantId     String
  name         String          @db.VarChar(80)
  scope        String
  tokenHash    String          @unique @db.Char(64)
  activeShopId String?
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  expiresAt    DateTime        @db.Timestamptz(6)
  revokedAt    DateTime?       @db.Timestamptz(6)
  lastUsedAt   DateTime?       @db.Timestamptz(6)
  events       AIAccessEvent[]

  @@index([userId, createdAt(sort: Desc)], map: "AIAccessGrant_userId_createdAt_idx")
  @@index([expiresAt], map: "AIAccessGrant_expiresAt_idx")
}

// No User FK: audit history is retained when an account is removed.
model AIAccessEvent {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String
  grantId   String?        @db.Uuid
  grant     AIAccessGrant? @relation(fields: [grantId], references: [id], onDelete: SetNull)
  type      String
  method    String?        @db.VarChar(10)
  path      String?
  status    Int?
  createdAt DateTime       @default(now()) @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)], map: "AIAccessEvent_userId_createdAt_idx")
  @@index([grantId, createdAt(sort: Desc)], map: "AIAccessEvent_grantId_createdAt_idx")
}

model GatewayBillingRule {
  planCode      String   @id
  planName      String
  multiplierBps Int      @default(10000)
  version       Int      @default(0)
  updatedBy     String?
  updatedAt     DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')")) @updatedAt
}

model GatewayBillingRuleAudit {
  id                    String   @id @default(cuid())
  planCode              String
  planName              String
  previousMultiplierBps Int
  multiplierBps         Int
  previousVersion       Int
  version               Int
  updatedBy             String
  updatedByUsername     String
  updatedByName         String
  reason                String
  createdAt             DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))

  @@unique([planCode, version])
  @@index([createdAt])
}

model GatewayBillingLedger {
  id                 String                    @id @default(cuid())
  billingEventId     String                    @unique
  kind               String
  userId             String
  tenantId           String
  tenantName         String                    @default("")
  username           String
  userName           String
  planCode           String
  planName           String
  multiplierBps      Int                       @default(10000)
  ruleVersion        Int                       @default(0)
  deltaCents         Int
  balanceBeforeCents Int
  balanceAfterCents  Int
  baseCostCents      Int                       @default(0)
  chargedCostCents   Int                       @default(0)
  endpoint           String                    @default("")
  provider           String                    @default("")
  model              String                    @default("")
  requestId          String                    @default("")
  apiKeyId           String?
  keyPrefix          String                    @default("")
  usageId            String?                   @unique
  orderId            String?
  promptTokens       Int                       @default(0)
  completionTokens   Int                       @default(0)
  totalTokens        Int                       @default(0)
  imageCount         Int                       @default(0)
  durationMs         Int?
  upstreamStatus     Int?
  status             String
  error              String                    @default("")
  actorId            String?
  actorUsername      String?
  actorName          String?
  reason             String?
  metadata           Json                      @default("{}")
  createdAt          DateTime                  @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  creditGift         GatewayCreditGift?
  creditSourceUsage  GatewayCreditSourceUsage?

  @@index([tenantId, userId, createdAt])
  @@index([userId, createdAt])
  @@index([planCode, createdAt])
  @@index([kind, createdAt])
}

model GatewayBillingHold {
  eventId            String                 @id
  userId             String
  tenantId           String
  apiKeyId           String?
  idempotencyHash    String?
  requestFingerprint String
  endpoint           String
  provider           String
  model              String
  quoteCents         Int
  heldCents          Int
  billingMode        String                 @default("reservation")
  amountDueCents     Int                    @default(0)
  chargedCents       Int                    @default(0)
  refundedCents      Int                    @default(0)
  cancelledAt        DateTime?
  refundFingerprint  String?
  settledCents       Int?
  status             String                 @default("reserved")
  billingSnapshot    Json
  outcomeFingerprint String?
  usageId            String?
  reason             String                 @default("")
  createdAt          DateTime               @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt          DateTime               @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  dispatchedAt       DateTime?
  nativeVideoJob     GatewayNativeVideoJob?
  credentialId       String?
  sourceBinding      Json?

  @@unique([userId, idempotencyHash])
  @@index([userId, status])
  @@index([status, updatedAt])
}

model GatewayBillingCancellation {
  userId          String
  idempotencyHash String
  createdAt       DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  @@id([userId, idempotencyHash])
}

// Pending native Seedance work exists before final usage/debit accounting.
// Credentials and user prompts/media bytes are never stored in this table.
model GatewayNativeVideoJob {
  id                 String             @id
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenantId           String
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  eventId            String             @unique
  hold               GatewayBillingHold @relation(fields: [eventId], references: [eventId], onDelete: Restrict)
  idempotencyHash    String
  requestFingerprint String
  bindingFingerprint String
  model              String
  upstreamModel      String
  tariff             Json
  providerTaskId     String?
  state              String             @default("reserved")
  resultUrl          String?
  completionTokens   Int?
  errorCode          String             @default("")
  createdAt          DateTime           @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt          DateTime           @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  // migration also adds a partial unique active-request index and CHECKs.
  credentialId       String?

  @@unique([userId, tenantId, idempotencyHash])
  @@unique([bindingFingerprint, providerTaskId])
  @@index([userId, tenantId, createdAt])
  @@index([state, updatedAt])
}

model GatewayBillingHoldEvent {
  id                  String   @id
  eventId             String
  userId              String
  transition          String
  reason              String   @default("")
  evidenceFingerprint String?
  createdAt           DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))

  @@index([eventId, createdAt])
}

model GatewaySupplyCredential {
  id              String    @id
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot            String
  name            String
  sealedKey       String
  status          String    @default("pending")
  providerKeyId   String?
  providerOwnerId String?
  providerGroupId String?
  leaseToken      String?
  leaseUntil      DateTime?
  retryAfter      DateTime?
  attempts        Int       @default(0)
  lastErrorCode   String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now())
  readyAt         DateTime?

  @@unique([userId, slot], map: "GatewaySupplyCredential_user_slot_key")
  @@index([status, retryAfter], map: "GatewaySupplyCredential_status_idx")
}
