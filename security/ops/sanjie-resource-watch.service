[Unit]
Description=Sample Sanjie server memory and disk headroom

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/libexec/sanjie-resource-watch.py
User=root
UMask=0077
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30
MemoryMax=64M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sanjie-resource-watch
